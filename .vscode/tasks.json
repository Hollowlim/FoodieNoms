{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start FoodieNoms demo",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "foodienoms",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "FoodieNoms demo listening on port"
        }
      }
    }
  ]
}

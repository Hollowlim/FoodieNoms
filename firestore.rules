rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function validNewProfile(uid) {
      let data = request.resource.data;
      return signedIn() && request.auth.uid == uid &&
        data.keys().hasAll(['name', 'role', 'approved', 'createdAt']) &&
        data.keys().hasOnly(['name', 'role', 'approved', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.name.matches('.*[^ ].*') &&
        data.role in ['customer', 'vendor'] && data.approved == false &&
        data.createdAt == request.time;
    }
    function approveVendor() {
      let data = request.resource.data;
      return admin() && resource.data.role == 'vendor' &&
        resource.data.approved == false && data.approved == true &&
        data.approvedBy == request.auth.uid && data.approvedAt == request.time &&
        data.diff(resource.data).affectedKeys().hasOnly(['approved', 'approvedBy', 'approvedAt']);
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      // An admin may query vendor applications, not the customer directory.
      allow list: if admin() && resource.data.role == 'vendor';
      allow create: if validNewProfile(uid);
      allow update: if approveVendor();
      allow delete: if false;
    }
    function hasRole(role) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function approvedVendor(uid) {
      let vendor = get(/databases/$(database)/documents/users/$(uid)).data;
      return vendor.role == 'vendor' && vendor.approved == true;
    }
    function boundedText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }
    function validDetails(d) {
      return boundedText(d.title,100) && boundedText(d.description,1000) &&
        boundedText(d.address,300) && boundedText(d.dietary,500) &&
        d.category in ['Bakery','Meals','Pastries','Other'] &&
        // Preset photos: Cloud Storage uploads would need the Blaze plan.
        (!('imageKey' in d) || d.imageKey in ['photo-0','photo-1','photo-2','photo-3']) &&
        d.priceCents is int && d.priceCents > 0 && d.priceCents <= 1000000 &&
        d.originalPriceCents is int && d.originalPriceCents >= d.priceCents && d.originalPriceCents <= 1000000 &&
        d.stock is int && d.stock <= 10000 &&
        d.pickupStart is int && d.pickupEnd is int &&
        d.pickupEnd > d.pickupStart && d.pickupEnd <= request.time.toMillis() + 2592000000;
    }
    function validListing() {
      let d = request.resource.data;
      return signedIn() && d.vendorId == request.auth.uid && approvedVendor(request.auth.uid) &&
        d.keys().hasAll(['title','description','address','dietary','category','priceCents','originalPriceCents','stock','pickupStart','pickupEnd','vendorId','vendorName','active','createdAt']) &&
        d.keys().hasOnly(['title','description','address','dietary','category','priceCents','originalPriceCents','stock','pickupStart','pickupEnd','vendorId','vendorName','active','createdAt','imageKey']) &&
        validDetails(d) &&
        d.vendorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
        // Vendors publish close to closing time, so a window may start now.
        d.stock > 0 && d.pickupStart >= request.time.toMillis() - 300000 &&
        d.pickupEnd > request.time.toMillis() &&
        d.active == true && d.createdAt == request.time;
    }
    // Existing orders keep their own snapshot, so edits never change them.
    function ownerEdit() {
      let d = request.resource.data;
      return signedIn() && resource.data.vendorId == request.auth.uid && approvedVendor(request.auth.uid) &&
        d.diff(resource.data).affectedKeys().hasOnly(['title','description','address','dietary','category','priceCents','originalPriceCents','stock','pickupStart','pickupEnd','imageKey']) &&
        validDetails(d) && d.stock >= 0 && d.pickupEnd > request.time.toMillis();
    }
    function ownerToggle() {
      let d = request.resource.data;
      return signedIn() && resource.data.vendorId == request.auth.uid && approvedVendor(request.auth.uid) &&
        d.active is bool && d.diff(resource.data).affectedKeys().hasOnly(['active']) &&
        (d.active == false || resource.data.pickupEnd > request.time.toMillis());
    }
    // Per student, per listing; 5 until agreed with TBS. Rules cannot count orders,
    // so listings/{id}/claims/{uid} keeps the running total of held items.
    function maxPerCustomer() { return 5; }
    function claimBefore(listingId, uid) {
      let claim = /databases/$(database)/documents/listings/$(listingId)/claims/$(uid);
      return exists(claim) ? get(claim).data.quantity : 0;
    }
    function claimAfter(listingId, uid) {
      return getAfter(/databases/$(database)/documents/listings/$(listingId)/claims/$(uid)).data.quantity;
    }
    function claimReservation(listingId, uid) {
      let d = request.resource.data;
      let orderId = d.lastReservationId;
      let order = getAfter(/databases/$(database)/documents/reservations/$(orderId)).data;
      return signedIn() && request.auth.uid == uid && hasRole('customer') &&
        !exists(/databases/$(database)/documents/reservations/$(orderId)) &&
        order.customerId == uid && order.listingId == listingId &&
        d.quantity is int && d.quantity == claimBefore(listingId, uid) + order.quantity &&
        d.quantity <= maxPerCustomer();
    }
    // Stock and claim changes are valid only as part of cancelling that same order.
    function cancelledTogether(orderId, listingId) {
      let before = get(/databases/$(database)/documents/reservations/$(orderId)).data;
      let after = getAfter(/databases/$(database)/documents/reservations/$(orderId)).data;
      return signedIn() && before.listingId == listingId && before.status == 'reserved' &&
        after.status == 'cancelled' && after.cancelledBy == request.auth.uid;
    }
    function inventoryRelease(listingId) {
      let d = request.resource.data;
      let orderId = d.lastReleaseId;
      return cancelledTogether(orderId, listingId) &&
        d.diff(resource.data).affectedKeys().hasOnly(['stock','lastReleaseId']) &&
        d.stock == resource.data.stock + get(/databases/$(database)/documents/reservations/$(orderId)).data.quantity;
    }
    function claimRelease(listingId, uid) {
      let d = request.resource.data;
      let orderId = d.lastReleaseId;
      let order = get(/databases/$(database)/documents/reservations/$(orderId)).data;
      return cancelledTogether(orderId, listingId) && order.customerId == uid &&
        d.diff(resource.data).affectedKeys().hasOnly(['quantity','lastReleaseId']) &&
        d.quantity == resource.data.quantity - order.quantity && d.quantity >= 0;
    }
    function inventoryReservation(listingId) {
      let d = request.resource.data;
      let orderId = d.lastReservationId;
      let order = getAfter(/databases/$(database)/documents/reservations/$(orderId)).data;
      return hasRole('customer') &&
        d.diff(resource.data).affectedKeys().hasOnly(['stock','lastReservationId']) &&
        !exists(/databases/$(database)/documents/reservations/$(orderId)) &&
        order.customerId == request.auth.uid && order.listingId == listingId &&
        order.quantity is int && order.quantity > 0 && order.quantity <= maxPerCustomer() &&
        d.stock is int && d.stock == resource.data.stock - order.quantity && d.stock >= 0 &&
        order.createdAt == request.time;
    }
    match /listings/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/listings/$(id)) ||
        resource.data.active == true || resource.data.vendorId == request.auth.uid || admin());
      allow list: if signedIn() && (resource.data.active == true || resource.data.vendorId == request.auth.uid || admin());
      allow create: if validListing();
      allow update: if ownerToggle() || ownerEdit() || inventoryReservation(id) || inventoryRelease(id);
      allow delete: if false;
      match /claims/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid ||
          (get(/databases/$(database)/documents/listings/$(id)).data.vendorId == request.auth.uid && approvedVendor(request.auth.uid)));
        allow create: if claimReservation(id, uid) && request.resource.data.keys().hasOnly(['quantity','lastReservationId']);
        allow update: if claimRelease(id, uid) || (claimReservation(id, uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity','lastReservationId']));
      }
    }
    function validReservation(id) {
      let d = request.resource.data;
      let listing = get(/databases/$(database)/documents/listings/$(d.listingId)).data;
      let nextListing = getAfter(/databases/$(database)/documents/listings/$(d.listingId)).data;
      return hasRole('customer') && id.matches('FN-[A-F0-9]{20}') && d.code == id &&
        d.keys().hasAll(['customerId','vendorId','listingId','title','vendorName','address','pickupStart','pickupEnd','quantity','unitPriceCents','totalCents','status','code','paymentStatus','createdAt']) &&
        d.keys().hasOnly(['customerId','vendorId','listingId','title','vendorName','address','pickupStart','pickupEnd','quantity','unitPriceCents','totalCents','status','code','paymentStatus','createdAt']) &&
        d.customerId == request.auth.uid && d.vendorId == listing.vendorId && approvedVendor(listing.vendorId) &&
        d.title == listing.title && d.vendorName == listing.vendorName && d.address == listing.address &&
        d.pickupStart is int && d.pickupEnd is int &&
        d.pickupStart == listing.pickupStart && d.pickupEnd == listing.pickupEnd &&
        d.quantity is int && d.quantity > 0 && d.quantity <= maxPerCustomer() &&
        claimAfter(d.listingId, d.customerId) == claimBefore(d.listingId, d.customerId) + d.quantity &&
        d.unitPriceCents is int && d.totalCents is int &&
        d.unitPriceCents == listing.priceCents && d.totalCents == listing.priceCents * d.quantity &&
        d.status == 'reserved' && d.paymentStatus == 'unpaid' && d.createdAt == request.time &&
        listing.active == true && listing.pickupEnd > request.time.toMillis() &&
        nextListing.stock == listing.stock - d.quantity && nextListing.stock >= 0 &&
        nextListing.lastReservationId == id &&
        nextListing.diff(listing).affectedKeys().hasOnly(['stock','lastReservationId']);
    }
    // Grace period either side of the window; 15 minutes until agreed with TBS.
    function pickupGraceMs() { return 900000; }
    function validCollection() {
      let d = request.resource.data;
      return signedIn() && approvedVendor(request.auth.uid) && resource.data.vendorId == request.auth.uid &&
        resource.data.status == 'reserved' && d.status == 'collected' && d.collectedAt == request.time &&
        request.time.toMillis() >= resource.data.pickupStart - pickupGraceMs() &&
        request.time.toMillis() <= resource.data.pickupEnd + pickupGraceMs() &&
        d.diff(resource.data).affectedKeys().hasOnly(['status','collectedAt']);
    }
    // Students cancel until the window ends; vendors also clear no-shows afterwards.
    function validCancellation(id) {
      let d = request.resource.data;
      let r = resource.data;
      let listing = /databases/$(database)/documents/listings/$(r.listingId);
      let claim = /databases/$(database)/documents/listings/$(r.listingId)/claims/$(r.customerId);
      return signedIn() && r.status == 'reserved' && d.status == 'cancelled' &&
        d.cancelledAt == request.time && d.cancelledBy == request.auth.uid &&
        d.diff(r).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy']) &&
        ((r.customerId == request.auth.uid && request.time.toMillis() < r.pickupEnd) ||
          (r.vendorId == request.auth.uid && approvedVendor(request.auth.uid))) &&
        getAfter(listing).data.stock == get(listing).data.stock + r.quantity &&
        getAfter(listing).data.lastReleaseId == id &&
        (!exists(claim) || getAfter(claim).data.quantity == get(claim).data.quantity - r.quantity);
    }
    match /reservations/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/reservations/$(id)) ||
        resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || admin());
      allow list: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || admin());
      allow create: if validReservation(id);
      allow update: if validCollection() || validCancellation(id);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

